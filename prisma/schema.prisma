generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// USER
// ──────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  name         String
  email       String    @unique
  passwordHash String
  role        String    // CUSTOMER | EDITOR | ADMIN
  avatarUrl   String?
  createdAt   DateTime  @default(now())

  ownedWorkspaces Workspace[]            @relation("Owner")
  memberships    WorkspaceMember[]
  customerOrders Order[]                @relation("CustomerOrders")
  drafts         Draft[]                @relation("Drafts")
  comments       ReviewComment[]
  deliveries    Deliverable[]
  messages       Message[]
  notifications Notification[]
  subscriptions  Subscription[]
  auditLogs     AuditLog[]
}

// ──────────────────────────────────────────────────────────────
// WORKSPACE
// ──────────────────────────────────────────────────────────────
model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  type      String   // CUSTOMER | TEAM
  notes     String?
  logoUrl   String?
  createdAt DateTime @default(now())

  owner   User             @relation("Owner", fields: [ownerId], references: [id])
  members WorkspaceMember[]
  invites Invite[]
  orders  Order[]
  messages Message[]
}

model WorkspaceMember {
  id           String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   // OWNER | MANAGER | VIEWER
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Invite {
  id          String   @id @default(cuid())
  workspaceId String
  email      String
  role       String   // OWNER | MANAGER | VIEWER
  token      String   @unique
  status     String   // PENDING | ACCEPTED | EXPIRED
  createdAt  DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────
// PACKAGE & ADDON
// ──────────────────────────────────────────────────────────────
model Package {
  id              String  @id @default(cuid())
  name           String
  kind           String  // HORIZONTAL | VERTICAL
  videoCount    Int
  pricePerVideo Int
  discountPercent Int   @default(0)
  isActive      Boolean @default(true)
}

model AddOn {
  id       String  @id @default(cuid())
  name    String
  price   Int
  isActive Boolean @default(true)
}

// ──────────────────────────────────────────────────────────────
// CREDIT
// ──────────────────────────────────────────────────────────────
model Credit {
  id      String @id @default(cuid())
  userId String
  kind    String // ADDON | CREDIT
  balance Int
}

// ──────────────────────────────────────────────────────────────
// ORDER
// ──────────────────────────────────────────────────────────────
model Order {
  id                String   @id @default(cuid())
  orderNo          String   @unique
  workspaceId      String?
  customerId       String
  kind             String   // HORIZONTAL | VERTICAL
  title            String
  brief            String?
  referenceLinks  String?
  rawFootageMinutes Int
  status          String   // DRAFT > SUBMITTED > ASSIGNED > IN_PROGRESS > IN_REVIEW > REVISION_REQUESTED > APPROVED > DELIVERED (or CANCELLED)
  dueAt            DateTime?
  managerId        String?
  editorId         String?
  thumbnailArtistId String?
  createdAt        DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id])
  customer   User     @relation("CustomerOrders", fields: [customerId], references: [id])

  orderAddOns OrderAddOn[]
  footage    FootageFile[]
  drafts     Draft[]
  comments  ReviewComment[]
  deliveries Deliverable[]
  messages   Message[]
}

model OrderAddOn {
  orderId String
  addOnId String
  order   Order @relation(fields: [orderId], references: [id])
  addOn   AddOn  @relation(fields: [addOnId], references: [id])
}

model FootageFile {
  id      String   @id @default(cuid())
  orderId String
  name    String
  size    Int?
  url     String?
  source  String // UPLOAD | LINK
}

model Draft {
  id            String   @id @default(cuid())
  orderId      String
  version      Int
  videoUrl     String?
  thumbnailUrl String?
  note         String?
  createdById String
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model ReviewComment {
  id          String  @id @default(cuid())
  draftId    String
  authorId   String
  timestampSec Int
  body       String
  status     String // OPEN | RESOLVED
  parentId   String?
  createdAt DateTime @default(now())

  draft Draft @relation(fields: [draftId], references: [id])
}

model Deliverable {
  id      String   @id @default(cuid())
  orderId String
  name    String
  url     String?
  type    String // FINAL | THUMBNAIL
}

model Message {
  id           String   @id @default(cuid())
  orderId     String?
  workspaceId String?
  senderId    String
  body        String
  attachmentUrl String?
  createdAt   DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────
// NOTIFICATION, SUBSCRIPTION, COUPON, AUDIT LOG
// ──────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId   String
  title    String
  body     String
  href     String?
  readAt   DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Subscription {
  id                 String   @id @default(cuid())
  userId            String
  plan              String   // STARTER | PRO
  billing           String   // QUARTERLY | ANNUAL
  status            String   // ACTIVE | CANCELLED | TRIAL
  currentPeriodEnd DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Coupon {
  id          String   @id @default(cuid())
  code       String   @unique
  type       String   // PERCENT | FIXED
  value      Int
  expiresAt  DateTime?
  usageLimit Int?
  used       Int      @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId  String
  action   String
  entity   String
  entityId String?
  meta     String?
  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────
// CONTENT / MARKETING MODELS (structure as placeholder relations)
// ──────────────────────────────────────────────────────────────
model Testimonial {
  id      String @id @default(cuid())
  content String
  author String
  role    String?
  createdAt DateTime @default(now())
}

model CaseStudy {
  id      String @id @default(cuid())
  title   String
  summary String
  result  String?
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String @id @default(cuid())
  question String
  answer   String
  createdAt DateTime @default(now())
}
